+        self.assertGreater((b.R+I('1.8')*b.dep.pulse(I('.67'))).lo, 1)
+        self.assertLess(fire.box().lo, D('.67'))
+        self.assertGreater(fire.box().hi, D('.66'))
+
+    def test_commutation_reuses_full_horizon_after_peak_bracket_failure(self):
+        b = engine.b
